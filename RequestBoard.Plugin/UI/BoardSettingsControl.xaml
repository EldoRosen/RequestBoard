<UserControl x:Class="RequestBoard.UI.BoardSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RequestBoard.Board">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <GroupBox Header="Board rules (stored in the database, shared by all servers using it)" Padding="8">
                <StackPanel>
                    <Grid x:Name="RulesFields" IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            <Style TargetType="TextBox"><Setter Property="Margin" Value="0,2"/><Setter Property="Width" Value="160"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
                            <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Text="Currency name"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Currency}"/>
                        <TextBlock Grid.Row="1" Text="Minimum price"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinPrice}"/>
                        <TextBlock Grid.Row="2" Text="Maximum price (0 = unlimited)"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxPrice}"/>
                        <TextBlock Grid.Row="3" Text="Deposit (% of price)"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DepositPercent}"/>
                        <TextBlock Grid.Row="4" Text="Posting fee (kept, never refunded)"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding PostingFee}"/>
                            <ComboBox Width="110" Margin="8,2,0,2" SelectedValuePath="Tag" SelectedValue="{Binding PostingFeeMode}">
                                <ComboBoxItem Content="Flat amount" Tag="{x:Static c:PostingFeeMode.Flat}"/>
                                <ComboBoxItem Content="% of price" Tag="{x:Static c:PostingFeeMode.Percent}"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="Max time limit (hours)"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MaxHours}"/>
                        <TextBlock Grid.Row="6" Text="Active requests per player"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MaxOpenPerPlayer}"/>
                        <TextBlock Grid.Row="7" Text="Cooldown between posts (minutes)"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CooldownMinutes}"/>
                        <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="Burn the deposit on fail (otherwise it goes to the requester)" IsChecked="{Binding BurnDepositOnFail}"/>
                        <CheckBox Grid.Row="9" Grid.ColumnSpan="2" Content="Include the requester's GPS location" IsChecked="{Binding IncludeGps}"/>
                        <TextBlock Grid.Row="10" Text="Discord webhook URL (empty = off)"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding DiscordWebhookUrl}" Width="Auto" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Reload" Width="140" Click="Pull_Click"/>
                        <Button x:Name="PushButton" Content="Save rules" Width="140" Margin="8,0,0,0" IsEnabled="False" Click="Push_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="RulesStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
