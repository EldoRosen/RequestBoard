<UserControl x:Class="RequestBoard.UI.RequestBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <TextBlock Text="Request Board" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <CheckBox Content="Enable plugin" IsChecked="{Binding Enabled}" Margin="0,0,0,10"/>

            <GroupBox Header="Request board service" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Service URL"/>
                    <TextBox Text="{Binding ServiceUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                    <TextBlock Text="Sector name (shown in messages)"/>
                    <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                    <TextBlock Text="Sync interval (seconds, minimum 10)"/>
                    <TextBox Text="{Binding SyncIntervalSeconds}" Width="160" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Test connection" Width="140" Click="Test_Click"/>
                        <TextBlock x:Name="TestStatus" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75" FontStyle="Italic"
                               Text="Every server connected to the same service shares one board, one set of rules and one Discord webhook."/>
                </StackPanel>
            </GroupBox>

            <Button Content="Save settings" Width="140" HorizontalAlignment="Left" Click="Save_Click" Margin="0,0,0,10"/>

            <GroupBox x:Name="RulesGroup" Header="Board rules (stored in the service, shared by all servers)" Padding="8" Margin="0,0,0,10">
                <StackPanel>
                    <Grid x:Name="RulesFields" IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            <Style TargetType="TextBox"><Setter Property="Margin" Value="0,2"/><Setter Property="Width" Value="160"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
                            <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Text="Currency name"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Currency}"/>
                        <TextBlock Grid.Row="1" Text="Minimum price"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinPrice}"/>
                        <TextBlock Grid.Row="2" Text="Maximum price (0 = unlimited)"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxPrice}"/>
                        <TextBlock Grid.Row="3" Text="Deposit (% of price)"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DepositPercent}"/>
                        <TextBlock Grid.Row="4" Text="Max time limit (hours)"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxHours}"/>
                        <TextBlock Grid.Row="5" Text="Active requests per player"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MaxOpenPerPlayer}"/>
                        <TextBlock Grid.Row="6" Text="Un-accepted requests expire after (hours)"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding OpenExpiryHours}"/>
                        <TextBlock Grid.Row="7" Text="Cooldown between posts (minutes)"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding CooldownMinutes}"/>
                        <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="Burn the deposit on fail (otherwise it goes to the requester)" IsChecked="{Binding BurnDepositOnFail}"/>
                        <CheckBox Grid.Row="9" Grid.ColumnSpan="2" Content="Include the requester's GPS location" IsChecked="{Binding IncludeGps}"/>
                        <TextBlock Grid.Row="10" Text="Discord webhook URL (empty = off)"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding DiscordWebhookUrl}" Width="Auto" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Pull from service" Width="140" Click="Pull_Click"/>
                        <Button x:Name="PushButton" Content="Push to service" Width="140" Margin="8,0,0,0" IsEnabled="False" Click="Push_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="RulesStatus" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Active requests" Padding="8">
                <StackPanel>
                    <DataGrid x:Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Height="200" SelectionMode="Single" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Requester" Binding="{Binding RequesterName}"/>
                            <DataGridTextColumn Header="Accepted by" Binding="{Binding AccepterName}"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                            <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Refresh" Width="90" Click="Refresh_Click"/>
                        <Button Content="Cancel &amp; refund selected" Width="170" Margin="8,0,0,0" Click="AdminCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Commands" Padding="8" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,3"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
                        </Grid.Resources>

                        <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" FontWeight="Bold" Text="!request &lt;price&gt; &lt;hours&gt; &lt;description&gt;"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Post a request. Price is taken and held until delivered, failed or cancelled. No quotes needed - everything after the hours is the description."/>

                        <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" FontWeight="Bold" Text="!requests"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="List all open requests with their number, sector, price, time limit and deposit (from every server connected to the service)."/>

                        <TextBlock Grid.Row="2" Grid.Column="0" FontFamily="Consolas" FontWeight="Bold" Text="!accept &lt;id&gt;"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Accept a request. A deposit is taken and held from the accepter. Cannot accept your own request."/>

                        <TextBlock Grid.Row="3" Grid.Column="0" FontFamily="Consolas" FontWeight="Bold" Text="!deliver &lt;id&gt;"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Requester only. Confirms delivery - the accepter is paid the price and gets their deposit back."/>

                        <TextBlock Grid.Row="4" Grid.Column="0" FontFamily="Consolas" FontWeight="Bold" Text="!fail &lt;id&gt;"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Requester only. Marks the job as failed - requester is refunded, accepter loses their deposit."/>

                        <TextBlock Grid.Row="5" Grid.Column="0" FontFamily="Consolas" FontWeight="Bold" Text="!cancelrequest &lt;id&gt;"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Requester only. Cancels a request nobody has accepted yet, with a full refund."/>

                        <TextBlock Grid.Row="6" Grid.Column="0" FontFamily="Consolas" FontWeight="Bold" Text="!admincancel &lt;id&gt;"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Admin only. Cancels any active request and refunds everyone involved. Same as the button above."/>

                        <TextBlock Grid.Row="7" Grid.Column="0" FontFamily="Consolas" FontWeight="Bold" Text="Example"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" FontFamily="Consolas" Text="!request 250000 6 500 iron ingots to Base Alpha"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="Plugin created by Eldo Rosen — The Destiny Universe"
                       HorizontalAlignment="Center" Margin="0,14,0,4"
                       FontStyle="Italic" Opacity="0.7"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
