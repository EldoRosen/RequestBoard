<UserControl x:Class="RequestBoard.UI.RequestBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Request Board" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock DockPanel.Dock="Bottom" Text="Plugin created by Eldo Rosen — The Destiny Universe"
                   HorizontalAlignment="Center" Margin="0,10,0,4"
                   FontStyle="Italic" Opacity="0.7"/>
        <TabControl>
            <TabItem Header="Info" x:Name="InfoTab"/>
            <TabItem Header="Settings" x:Name="GeneralTab"/>
            <TabItem Header="Request board settings" x:Name="BoardTab"/>
        </TabControl>
    </DockPanel>
</UserControl>
