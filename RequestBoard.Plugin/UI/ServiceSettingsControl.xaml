<UserControl x:Class="RequestBoard.UI.ServiceSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <GroupBox Header="Request board service" Padding="8" Margin="8">
            <StackPanel>
                <TextBlock Text="Service URL"/>
                <TextBox Text="{Binding ServiceUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                <TextBlock Text="Sector name (shown in messages)"/>
                <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                <TextBlock Text="Sync interval (seconds, minimum 10)"/>
                <TextBox Text="{Binding SyncIntervalSeconds}" Width="160" HorizontalAlignment="Left" Margin="0,2,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Save settings" Width="140" Click="Save_Click"/>
                    <Button Content="Test connection" Width="140" Margin="8,0,0,0" Click="Test_Click"/>
                    <TextBlock x:Name="Status" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75" FontStyle="Italic"
                           Text="Every server connected to the same service shares one board, one set of rules and one Discord webhook."/>
            </StackPanel>
        </GroupBox>
    </ScrollViewer>
</UserControl>
